{% set input_id = id ~ '_autocomplete' %}
{% set has_admin = sensiolabs_admin is defined and sensiolabs_admin.admin is defined and sensiolabs_admin.admin is not same as(false) and sensiolabs_admin.admin is not same as('') %}
{% set extra_params = {
    '_sensiolabs_admin': has_admin ? sensiolabs_admin.admin.baseCodeRoute : (admin_code ?? ''),
    'uniqid': has_admin ? sensiolabs_admin.admin.uniqid : '',
    'field': context == 'filter' ? full_name|replace({'filter[': '', '][value]': '', '__':'.'}) : name,
    '_context': context == 'filter' ? 'filter' : ''
}|merge(req_params|default({})) %}

<div class="admin-autocomplete {{ container_css_class }}"
     data-controller="sensiolabs-de--admin-bundle--autocomplete"
     data-sensiolabs-de--admin-bundle--autocomplete-url-value="{{ url ?: path(route.name, route.parameters|default([])) }}"
     data-sensiolabs-de--admin-bundle--autocomplete-min-length-value="{{ minimum_input_length }}"
     data-sensiolabs-de--admin-bundle--autocomplete-delay-value="{{ delay }}"
     data-sensiolabs-de--admin-bundle--autocomplete-multiple-value="{{ multiple ? 'true' : 'false' }}"
     data-sensiolabs-de--admin-bundle--autocomplete-param-name-value="{{ req_param_name_search }}"
     data-sensiolabs-de--admin-bundle--autocomplete-page-param-value="{{ req_param_name_page_number }}"
     data-sensiolabs-de--admin-bundle--autocomplete-per-page-param-value="{{ req_param_name_items_per_page }}"
     data-sensiolabs-de--admin-bundle--autocomplete-per-page-value="{{ items_per_page }}"
     data-sensiolabs-de--admin-bundle--autocomplete-extra-params-value="{{ extra_params|json_encode }}"
     data-sensiolabs-de--admin-bundle--autocomplete-input-name-value="{{ full_name }}"
     data-sensiolabs-de--admin-bundle--autocomplete-placeholder-value="{{ placeholder ?: 'search_placeholder'|trans({}, 'SensioLabsAdminBundle') }}"
     data-sensiolabs-de--admin-bundle--autocomplete-no-results-text-value="{{ 'no_results_found'|trans({}, 'SensioLabsAdminBundle') }}"
     data-sensiolabs-de--admin-bundle--autocomplete-loading-text-value="{{ 'loading_information'|trans({}, 'SensioLabsAdminBundle') }}"
     data-sensiolabs-de--admin-bundle--autocomplete-safe-label-value="{{ safe_label ? 'true' : 'false' }}">

    {# Selected items display #}
    <div class="admin-autocomplete-container">
        {# Selected tags (for multiple) or single value display #}
        <div class="admin-autocomplete-selected" data-sensiolabs-de--admin-bundle--autocomplete-target="selected">
            {%- for idx, val in value|filter((val, idx) => idx~'' != '_labels') -%}
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-sm bg-primary-100 text-primary-800">
                    <span class="truncate max-w-[200px]">{{ value['_labels'][idx] }}</span>
                    <button type="button"
                        class="hover:text-primary-600 focus:outline-none"
                        data-action="click->sensiolabs-de--admin-bundle--autocomplete#removeItem"
                        data-sensiolabs-de--admin-bundle--autocomplete-id-param="{{ val }}">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </span>
            {%- endfor -%}
        </div>

        {# Search input #}
        <input type="text"
               id="{{ input_id }}"
               class="admin-autocomplete-input"
               placeholder="{{ placeholder ?: 'search_placeholder'|trans({}, 'SensioLabsAdminBundle') }}"
               autocomplete="off"
               {%- if disabled %} disabled="disabled"{% endif %}
               data-sensiolabs-de--admin-bundle--autocomplete-target="input"
               data-action="input->sensiolabs-de--admin-bundle--autocomplete#onInput focus->sensiolabs-de--admin-bundle--autocomplete#onFocus"
               {%- for attribute, attrvalue in attr %} {{ attribute }}="{{ attrvalue }}"{% endfor -%}>

        {# Clear button (single select only) #}
        {% if not multiple and not required %}
            <button type="button"
                    class="admin-autocomplete-clear hidden"
                    data-action="click->sensiolabs-de--admin-bundle--autocomplete#clear"
                    title="{{ 'btn_clear'|trans({}, 'SensioLabsAdminBundle') }}">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        {% endif %}
    </div>

    {# Dropdown #}
    <div class="admin-autocomplete-dropdown hidden {{ dropdown_css_class }}"
         data-sensiolabs-de--admin-bundle--autocomplete-target="dropdown">
        <div class="admin-autocomplete-results"
             data-sensiolabs-de--admin-bundle--autocomplete-target="results">
        </div>
        <div class="admin-autocomplete-footer">
            <span class="admin-autocomplete-footer-item">
                <kbd>↑</kbd><kbd>↓</kbd> navigate
            </span>
            <span class="admin-autocomplete-footer-item">
                <kbd>↵</kbd> select
            </span>
            <span class="admin-autocomplete-footer-item">
                <kbd>esc</kbd> close
            </span>
        </div>
    </div>

    {# Hidden inputs for form submission #}
    <div data-sensiolabs-de--admin-bundle--autocomplete-target="hiddenInputs">
        {% if multiple -%}
            {%- for idx, val in value|filter((val, idx) => idx~'' != '_labels') -%}
                <input type="hidden" name="{{ full_name }}[]" value="{{ val }}" data-label="{{ value['_labels'][idx] }}" {%- if disabled %} disabled="disabled"{% endif %}>
            {%- endfor -%}
        {% else -%}
            <input type="hidden" name="{{ full_name }}" value="{{ value[0]|default('') }}" data-label="{{ value['_labels'][0]|default('') }}" {%- if disabled %} disabled="disabled"{% endif %}>
        {% endif -%}
    </div>
</div>

{% set has_field_description = sensiolabs_admin is defined and sensiolabs_admin.field_description|default(null) is not null %}
{% if has_field_description and sensiolabs_admin.field_description.hasAssociationAdmin %}
    {% set display_btn_add = sensiolabs_admin.edit != 'admin' and sensiolabs_admin.field_description.associationadmin.hasRoute('create')
                             and sensiolabs_admin.field_description.associationadmin.isGranted('CREATE') and btn_add %}
    {% if display_btn_add %}
        <div class="admin-autocomplete-actions mt-2">
            <a href="{{ sensiolabs_admin.field_description.associationadmin.generateUrl('create', sensiolabs_admin.field_description.getOption('link_parameters', {})) }}"
               onclick="return start_field_dialog_form_add_{{ id }}(this);"
               class="inline-flex items-center gap-1.5 text-sm text-primary-600 hover:text-primary-700 font-medium">
                {{ ux_icon('lucide:plus-circle', {class: 'w-4 h-4'}) }}
                {{ btn_translation_domain is same as(false) ? btn_add : btn_add|trans({}, btn_translation_domain) }}
            </a>
        </div>
        {% include '@SensioLabsAdmin/CRUD/Association/edit_modal.html.twig' %}
        {% include '@SensioLabsAdmin/CRUD/Association/edit_many_script.html.twig' %}
    {% endif %}
{% endif %}
